          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT run_id\n  FROM meta.etl_runs\n  WHERE status = 'success'\n  ORDER BY finished_at DESC NULLS LAST\n  LIMIT 1\n)\nSELECT city_name, forecast_ts_utc, precipitation, precipitation_probability, weathercode, storm_risk_flag, round(risk_score::numeric,2) AS risk_score\nFROM mart.mart_city_hourly_risk m\nJOIN latest l ON m.run_id = l.run_id\nWHERE (\n    '${city_name:csv}' = '$__all'\n    OR btrim('${city_name:csv}') = ''\n    OR city_name IN (\n      SELECT btrim(x)\n      FROM unnest(string_to_array('${city_name:csv}', ',')) AS u(x)\n      WHERE btrim(x) <> ''\n    )\n  )\nORDER BY storm_risk_flag DESC, risk_score DESC, forecast_ts_utc ASC\nLIMIT 50;",
          "refId": "A"
        }
      ],
