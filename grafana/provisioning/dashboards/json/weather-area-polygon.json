      "targets": [
        {
          "datasource": "WeatherDW",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT place_name,\n       max(risk_score) AS max_risk\nFROM api.area_selection_hourly\nWHERE selection_id = CAST(NULLIF(TRIM('${selection_id}'), '') AS uuid)\nGROUP BY place_name\nORDER BY max_risk DESC;",
