          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 27 },
      "id": 14,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "pluginVersion": "11.3.0",
      "targets": [
        {
          "datasource": "WeatherDW",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT forecast_ts_utc AS time,\n       'Max WMO code (area)' AS metric,\n       max(weathercode)::double precision AS value\nFROM api.area_selection_hourly\nWHERE selection_id = CAST(NULLIF(TRIM('${selection_id}'), '') AS uuid)\nGROUP BY forecast_ts_utc\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "WMO weather code — max in polygon",
      "type": "timeseries"
    },
    {
      "datasource": "WeatherDW",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
