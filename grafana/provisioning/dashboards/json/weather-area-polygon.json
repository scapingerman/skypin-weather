      "targets": [
        {
          "datasource": "WeatherDW",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT forecast_ts_utc AS time,\n       place_name AS metric,\n       risk_score AS value\nFROM api.area_selection_hourly\nWHERE selection_id = CAST(NULLIF(TRIM('${selection_id}'), '') AS uuid)\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "Risk score by place (hourly)",
      "type": "timeseries"
    },
    {
      "datasource": "WeatherDW",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 33 },
      "id": 18,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
