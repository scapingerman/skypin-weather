# Copy to .env and adjust (docker compose loads .env automatically)
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weather_dw
POSTGRES_PORT=5432

GF_SECURITY_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
# Grafana embed demo: GF_SECURITY_ALLOW_EMBEDDING + anonymous Viewer are set in docker-compose.yml

API_PORT=8000
# When running the API outside Docker, point it at Postgres so Grafana iframes get var-city_name matches:
# POSTGRES_HOST=localhost
# Persist map polygon hourly rows for Grafana dashboard "Weather area polygon" (requires api.area_selection_hourly):
# API_PERSIST_SELECTION=true
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

OPEN_METEO_FORECAST_DAYS=3
LOG_LEVEL=INFO
